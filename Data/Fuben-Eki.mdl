{UTF-8}
Fuben eki switch=1
	~	Dmnl
	~		|

Commitment=Fuben eki switch*Learning rate*Relative performance gap*(1-Fuben eki)
	~	1/Month
	~		|

Audit Intensity Adv= INTEG (Audit adjusment,
		Min Audit)
	~	Dmnl
	~		|

Drift shock magnitude Adv=0.1
	~	1/Month
	~		|

Rework time=1
	~	Month
	~		|

Drift extra Adv=Shock Adv*Drift shock magnitude Adv
	~	1/Month
	~		|

Contamination removal Adv=MIN ( Contamination stock Adv / Rework time , Rework Capacity Adv\
		 )
	~	Ton/Month
	~		|

Relative performance gap=MAX ( 0 , (Performance deterioration- Performance expected deterioration\
		) / Performance expected deterioration )
	~	Dmnl
	~		|

Human intervention burden=Audit Intensity Adv*Intervention burden factor
	~	Dmnl
	~		|

Intervention burden factor=0.2
	~	Dmnl
	~		|

Decay=Forgetting rate*(1 - MIN ( 1 , Relative performance gap))*Fuben eki
	~	1/Month
	~		|

Performance expected deterioration=SMOOTH ( Performance deterioration , Expected adjustment time\
		 )
	~	Dmnl
	~		|

Cumulative emission Adv= INTEG (Total Emission Adv,
		0)
	~	tCO2
	~		|

Audit Target=Min Audit+(Max Audit-Min Audit)*MIN ( 1 , Relative performance gap+ 0.6 \
		*Fuben eki )
	~	Dmnl
	~		|

Total Emission Adv=Virgin demand Adv*EF Resin and Forming Adv+Recycled output Adv*EF Recycled Adv\
		+Contamination removal Adv*EF Rework Adv
	~	tCO2/Month
	~		|

Expected adjustment time=6
	~	Month
	~		|

Acc deacy=AI Model Accuracy*Concept drift rate
	~	1/Month
	~		|

Acc decay Adv=AI Model Accuracy Adv*Concept drift rate Adv
	~	1/Month
	~		|

Acc gain=ACC learn rate*Audit Intensity*(1-AI Model Accuracy)
	~	1/Month
	~		|

Acc gain Adv=ACC learn rate Adv*Audit Intensity Adv*(1-AI Model Accuracy Adv)
	~	1/Month
	~		|

ACC learn rate=0.4
	~	1/Month
	~		|

ACC learn rate Adv=0.4
	~	1/Month
	~		|

Ai Effect=0.7
	~	Dmnl
	~		|

Ai Effect Adv=0.7
	~	Dmnl
	~		|

AI Model Accuracy= INTEG (Acc gain-Acc deacy,
		0.7)
	~	Dmnl
	~		|

AI Model Accuracy Adv= INTEG (Acc gain Adv-Acc decay Adv,
		0.8)
	~	Dmnl
	~		|

Audit adjusment=(Audit Target - Audit Intensity Adv) / Audit adjust time
	~	Dmnl/Month
	~		|

Audit adjust time=2
	~	Month
	~		|

Audit Intensity=Base Audit+"Fuben-Eki"
	~	Dmnl
	~		|

Automation Bias=0.25
	~	Dmnl
	~		|

Automation Bias Adv=0.25
	~	Dmnl
	~		|

Base Audit=0.05
	~	Dmnl
	~		|

Base Error=0.18+0.05*Shock
	~	Dmnl
	~		|

Base Error Adv=0.18+0.05*Shock Adv
	~	Dmnl
	~		|

Base recycled share=0.6
	~	Dmnl
	~		|

Base recycled share Adv=0.6
	~	Dmnl
	~		|

Concept drift rate=Concept drift base+Drift extra
	~	1/Month
	~		|

Concept drift rate Adv=Concept drift base Adv+Drift extra Adv
	~	1/Month
	~		|

Concept drift base=0.05
	~	1/Month
	~		|

Concept drift base Adv=0.05
	~	1/Month
	~		|

Contam ref=120
	~	Ton
	~		|

Contamination generation=Plastic Input*Sorting Error rate
	~	Ton/Month
	~		|

Contamination generation Adv=Plastic Input Adv*Sorting Error rate Adv
	~	Ton/Month
	~		|

Contamination removal=Rework Capacity*Contamination stock/(Contamination stock+K half\
		)
	~	Ton/Month
	~		|

Contamination stock= INTEG (Contamination generation-Contamination removal,
		50)
	~	Ton
	~		|

Contamination stock Adv= INTEG (Contamination generation Adv-Contamination removal Adv\
		,
		50)
	~	Ton
	~		|

Demand Total=900
	~	Ton/Month
	~		|

Demand Total Adv=900
	~	Ton/Month
	~		|

Drift extra=0.1
	~	1/Month
	~		|

EF Recycled=0.7
	~	tCO2/Ton
	~		|

EF Recycled Adv=0.8
	~	tCO2/Ton
	~		|

EF Rework=0.2
	~	tCO2/Ton
	~		|

EF Rework Adv=0.74
	~	tCO2/Ton
	~	Make it same as forming
	|

EF Virgin=2.5
	~	tCO2/Ton
	~		|

EF Resin and Forming Adv=2.46
	~	tCO2/Ton
	~		|

Error ref=0.12
	~	Dmnl
	~		|

Forget rate=0.1
	~	1/Month
	~		|

Forget rate Adv=0.1
	~	1/Month
	~		|

Forgetting rate=0.05
	~	1/Month
	~		|

Fuben eki= INTEG (Commitment-Decay,
		0)
	~	Dmnl
	~		|

"Fuben-Eki"=0
	~	Dmnl
	~		|

Human Effect=0.6
	~	Dmnl
	~		|

Human Effect Adv=0.6
	~	Dmnl
	~		|

K half=200
	~	Ton
	~		|

Learn rate=0.6
	~	1/Month
	~		|

Learn rate Adv=0.6
	~	1/Month
	~		|

Learning rate=0.2
	~	1/Month
	~		|

Max Audit=0.3
	~	Dmnl
	~		|

Min Audit=0.05
	~	Dmnl
	~		|

Min Verification=0.5
	~	Dmnl
	~		|

Max Verification Adv=0.5
	~	Dmnl
	~		|

Operator Skill= INTEG (Skill gain-Skill decay,
		0.4)
	~	Dmnl
	~		|

Operator Skill Adv= INTEG (Skill gain Adv-Skill decay Adv,
		0.8)
	~	Dmnl
	~		|

Performance deterioration=0.5*MIN ( 1 , Sorting Error rate Adv/Error ref ) + 0.5*MIN \
		( 1 , Contamination stock Adv/Contam ref )
	~	Dmnl
	~		|

Plastic Input=1000
	~	Ton/Month
	~		|

Plastic Input Adv=1000
	~	Ton/Month
	~		|

Quality Index=1/(1+Quality Sensitivity*Contamination stock/Plastic Input)
	~	Dmnl
	~		|

Quality Index Adv=1/(1+Quality Sensitivity Adv*Contamination stock Adv/Plastic Input Adv\
		)
	~	Dmnl
	~		|

Quality Sensitivity=3
	~	Dmnl
	~		|

Quality Sensitivity Adv=3
	~	Dmnl
	~		|

Recycled output=Demand Total*Recycled share
	~	Ton/Month
	~		|

Recycled output Adv=Demand Total Adv*Recycled share Adv
	~	Ton/Month
	~		|

Recycled share=Base recycled share*Quality Index
	~	Dmnl
	~		|

Recycled share Adv=Base recycled share Adv*Quality Index Adv
	~	Dmnl
	~		|

Rework Capacity=120
	~	Ton/Month
	~		|

Rework Capacity Adv=120
	~	Ton/Month
	~		|

Shock=PULSE ( 12 , 1 )
	~	Dmnl
	~		|

Shock Adv=STEP(1,30)-STEP(1,36)
	~	Dmnl
	~		|

Shock Sensitivity=0.8
	~	Dmnl
	~		|

Shock Sensitivity Adv=0.8
	~	Dmnl
	~		|

Skill decay=Forget rate*(1-Audit Intensity)*Operator Skill
	~	1/Month
	~		|

Skill decay Adv=Forget rate Adv*(1-Audit Intensity Adv)*Operator Skill Adv
	~	1/Month
	~		|

Skill gain=Learn rate*Audit Intensity*(1-Operator Skill)
	~	1/Month
	~		|

Skill gain Adv=Learn rate Adv*Audit Intensity Adv*(1-Operator Skill Adv)
	~	1/Month
	~		|

Sorting Error rate=Base Error*(1-Human Effect*Operator Skill)*(1-Ai Effect*AI Model Accuracy\
		)*(1+Automation Bias*Trust AI*(1-Verification Effort))
	~	Dmnl
	~		|

Sorting Error rate Adv=Base Error Adv*(1-Human Effect Adv*Operator Skill Adv)*(1-Ai Effect Adv\
		*AI Model Accuracy Adv)*(1+Automation Bias Adv*Trust AI Adv*(1-Verification Effort Adv\
		))
	~	Dmnl
	~		|

Total Emission=Virgin demand*EF Virgin+Recycled output*EF Recycled+Contamination removal\
		*EF Rework
	~	tCO2/Month
	~		|

Trust AI= INTEG (Trust gain-Trust decay,
		0.6)
	~	Dmnl
	~		|

Trust AI Adv= INTEG (Trust gain Adv-Trust decay Adv,
		0.7)
	~	Dmnl
	~		|

Trust decay=Shock*Shock Sensitivity*Trust AI
	~	1/Month
	~		|

Trust decay Adv=Shock Adv*Shock Sensitivity Adv*Trust AI Adv
	~	1/Month
	~		|

Trust gain=Trust speed*(AI Model Accuracy-Trust AI)
	~	1/Month
	~		|

Trust gain Adv=Trust speed Adv*(AI Model Accuracy Adv-Trust AI Adv)
	~	1/Month
	~		|

Trust speed=0.5
	~	1/Month
	~		|

Trust speed Adv=0.5
	~	1/Month
	~		|

Verification Effort=MIN ( Min Verification , Audit Intensity * (1 - Trust AI ))
	~	Dmnl
	~		|

Verification Effort Adv=MIN ( Max Verification Adv , Audit Intensity Adv * (1 - Trust AI Adv\
		 ))
	~	Dmnl
	~		|

Virgin demand=Demand Total*(1-Recycled share)
	~	Ton/Month
	~		|

Virgin demand Adv=Demand Total Adv*(1-Recycled share Adv)
	~	Ton/Month
	~		|

